{
	Tools = ordered() {
		zoom = GroupOperator {
			CtrlWZoom = false,
			CustomData = {
				Path = {
					Map = {
						["Setting:"] = "Templates:\\Edit\\Effects\\Datitles\\"
					}
				},
			},
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Zoom", Source = "Input", },
				Input1 = InstanceInput { SourceOp = "Zoom", Source = "Sentido", Default = 0, },
				Input2 = InstanceInput { SourceOp = "Zoom", Source = "Escala", Default = 120, },
				Input3 = InstanceInput { SourceOp = "Zoom", Source = "Curva", Default = 0, },
				Input4 = InstanceInput { SourceOp = "Zoom", Source = "Suavizar", Default = 0, },
				Input5 = InstanceInput { SourceOp = "Zoom", Source = "Ancla", Default = 4, },
				Input6 = InstanceInput { SourceOp = "Zoom", Source = "Punto", },
				Input7 = InstanceInput { SourceOp = "Zoom", Source = "TimeNest", },
				Input8 = InstanceInput { SourceOp = "Zoom", Source = "Animacion", Default = 0, },
				Input9 = InstanceInput { SourceOp = "Zoom", Source = "Duracion", Default = 1, },
				Input10 = InstanceInput { SourceOp = "Zoom", Source = "Progreso", Default = 0, },
				Input11 = InstanceInput { SourceOp = "Zoom", Source = "BlurNest", },
				Input12 = InstanceInput { SourceOp = "Zoom", Source = "MotionBlur", Name = "Prendido", Default = 0, },
				Input13 = InstanceInput { SourceOp = "Zoom", Source = "Quality", Name = "Calidad", Default = 4, },
				Input14 = InstanceInput { SourceOp = "Zoom", Source = "ShutterAngle", Name = "Obturador (°)", Default = 180, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Zoom", Source = "Output", }
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
				Flags = { AllowPan = false, AutoSnap = true, RemoveRouters = true },
				Direction = "Horizontal",
				PipeStyle = "Direct",
				Scale = 1,
				Offset = { 0, 0 }
			},
			Tools = ordered() {
				Zoom = Transform {
					CtrlWZoom = false,
					Inputs = {
						Avance = Input { Expression = ":local t = Progreso\nif Animacion < 3 then\n  local first, last = comp.RenderStart, comp.RenderEnd\n  local n = last - first\n  if Animacion > 0 then\n    local fps = comp:GetPrefs('Comp.FrameFormat.Rate') or comp:GetPrefs().Comp.FrameFormat.Rate\n    n = math.min(Duracion * fps, n)\n  end\n  local start = Animacion == 2 and last - n or first\n  t = n > 0 and (time - start) / n or 1\nend\nt = math.min(math.max(t, 0), 1)\nif Curva == 0 then return t end\nlocal function lento(u)\n  if Curva == 1 then return 1 - math.cos(u * math.pi / 2) end\n  if Curva == 6 then return (2 ^ (10 * u) - 1) / 1023 end\n  if Curva == 7 then return 1 - math.sqrt(1 - u * u) end\n  return u ^ Curva\nend\nif Suavizar == 1 then return lento(t) end\nif Suavizar == 2 then return 1 - lento(1 - t) end\nif t < 0.5 then return lento(2 * t) / 2 end\nreturn 1 - lento(2 - 2 * t) / 2", },
						Size = Input { Expression = "(Escala / 100) ^ (Sentido == 0 and Avance or 1 - Avance)", },
						Center = Input { Expression = ":local x, y = Punto.X, Punto.Y\nif Ancla < 9 then\n  x, y = (Ancla % 3) / 2, 1 - math.floor(Ancla / 3) / 2\nend\nx, y = math.min(math.max(x, 0), 1), math.min(math.max(y, 0), 1)\nreturn Point(x + Size * (0.5 - x), y + Size * (0.5 - y))", },
						MotionBlur = Input { Value = 0, },
						Quality = Input { Value = 4, },
						ShutterAngle = Input { Value = 180, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
					UserControls = ordered() {
						Sentido = {
							LINKS_Name = "Sentido",
							LINKID_DataType = "Number",
							INPID_InputControl = "MultiButtonControl",
							INP_Default = 0,
							INP_Integer = true,
							{ MBTNC_AddButton = "Zoom in", MBTNCD_ButtonWidth = 0.5 },
							{ MBTNC_AddButton = "Zoom out", MBTNCD_ButtonWidth = 0.5 },
						},
						Escala = {
							LINKS_Name = "Escala (%)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 120,
							INP_MinScale = 100,
							INP_MaxScale = 300,
							INP_MinAllowed = 100,
						},
						Curva = {
							LINKS_Name = "Curva",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							CC_LabelPosition = "Horizontal",
							INP_Default = 0,
							INP_Integer = true,
							{ CCS_AddString = "Lineal" },
							{ CCS_AddString = "Seno" },
							{ CCS_AddString = "Cuadrática" },
							{ CCS_AddString = "Cúbica" },
							{ CCS_AddString = "Cuártica" },
							{ CCS_AddString = "Quíntica" },
							{ CCS_AddString = "Exponencial" },
							{ CCS_AddString = "Circular" },
						},
						Suavizar = {
							LINKS_Name = "Suavizar",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							CC_LabelPosition = "Horizontal",
							INP_Default = 0,
							INP_Integer = true,
							{ CCS_AddString = "Al empezar y al terminar" },
							{ CCS_AddString = "Al empezar" },
							{ CCS_AddString = "Al terminar" },
						},
						Ancla = {
							LINKS_Name = "Ancla",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							CC_LabelPosition = "Horizontal",
							INP_Default = 4,
							INP_Integer = true,
							{ CCS_AddString = "Arriba a la izquierda" },
							{ CCS_AddString = "Arriba" },
							{ CCS_AddString = "Arriba a la derecha" },
							{ CCS_AddString = "Izquierda" },
							{ CCS_AddString = "Centro" },
							{ CCS_AddString = "Derecha" },
							{ CCS_AddString = "Abajo a la izquierda" },
							{ CCS_AddString = "Abajo" },
							{ CCS_AddString = "Abajo a la derecha" },
							{ CCS_AddString = "Punto" },
						},
						Punto = {
							LINKS_Name = "Punto",
							LINKID_DataType = "Point",
							INPID_InputControl = "OffsetControl",
							INPID_PreviewControl = "CrosshairControl",
							INP_DefaultX = 0.5,
							INP_DefaultY = 0.5,
						},
						TimeNest = {
							LINKS_Name = "Tiempo",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 3,
							INP_Integer = false,
							INP_Default = 1,
							INP_Passive = true,
							INP_SplineType = "Default",
						},
						Animacion = {
							LINKS_Name = "Animación",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							CC_LabelPosition = "Horizontal",
							INP_Default = 0,
							INP_Integer = true,
							{ CCS_AddString = "Todo el clip" },
							{ CCS_AddString = "Al principio" },
							{ CCS_AddString = "Al final" },
							{ CCS_AddString = "Manual" },
						},
						Duracion = {
							LINKS_Name = "Duración (s)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 5,
							INP_MinAllowed = 0,
						},
						Progreso = {
							LINKS_Name = "Progreso",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
						},
						BlurNest = {
							LINKS_Name = "Motion blur",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 3,
							INP_Integer = false,
							INP_Default = 1,
							INP_Passive = true,
							INP_SplineType = "Default",
						},
						Avance = {
							LINKS_Name = "Avance",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							IC_Visible = false,
						},
					},
				},
			},
		},
	},
	ActiveTool = "zoom"
}
